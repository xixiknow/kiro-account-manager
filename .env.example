# Required: admin login token for the Web UI and /admin/api/*
KAM_ADMIN_TOKEN=change-this-admin-token

# Required: client keys accepted by /v1/* Gateway APIs, comma-separated.
KAM_CLIENT_API_KEYS=change-this-client-api-key

# Public URL shown in the admin UI. Nginx owns HTTPS.
KAM_PUBLIC_BASE_URL=https://kiro.example.com

# Host port bound on 127.0.0.1 for the host Nginx reverse proxy.
KAM_PUBLISHED_PORT=8765

# Optional: allowlist source IPs seen by the container. Defaults include common private Docker ranges.
# KAM_ALLOWED_IPS=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# Optional: override Prompt Cache target percent on container start.
# KAM_PROMPT_CACHE_TARGET_PERCENT=90

RUST_LOG=info
